# ==============================================================================
# HEAT LABEL — Database and Application Configuration
# Copy this file to application.properties and adapt credentials for local MySQL.
# Do NOT commit application.properties with production passwords to Git.
# Alternatively, environment variables HEAT_LABEL_DB_* will automatically override.
# ==============================================================================

# JDBC Connection Settings
db.url=jdbc:mysql://localhost:3306/heat_label_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=heat_user
db.password=HeatSecret#2026
db.driver=com.mysql.cj.jdbc.Driver

# Connection Pool Defaults
db.pool.initialSize=5
db.pool.maxTotal=20
db.pool.maxWaitMillis=10000

# Application Branding and Industrial Defaults
app.name=HEAT LABEL
app.version=1.0.0-RELEASE
app.company.name=HEAT LABEL Industrial Thermal Solutions
app.furnace.default_chamber=FURNACE-ALPHA-1
app.locale=en-US

# Default Emission Calculation Baseline Factors
# Grid Electricity Baseline: 0.716 kg CO2e / kWh (CEA v19)
emission.factor.default.grid=0.716000
# Natural Gas: 2.020 kg CO2e / m3 (IPCC 2006)
emission.factor.default.gas=2.020000
